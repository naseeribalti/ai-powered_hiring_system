{
  "info": {
    "_postman_id": "ai-hiring-system-collection",
    "name": "AI Hiring System API",
    "description": "Complete API collection for AI Hiring System backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "User authentication endpoints",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePassword123\",\n  \"role\": \"jobSeeker\",\n  \"phone\": \"+1-555-0123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a new user account (job seeker, recruiter, or admin)"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const responseData = pm.response.json();",
                  "  pm.environment.set('token', responseData.token);",
                  "  pm.environment.set('user_id', responseData.user._id);",
                  "  pm.environment.set('user_role', responseData.user.role);",
                  "  console.log('Token saved to environment');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jobseeker@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user and receive JWT token"
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieve current authenticated user's profile"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "description": "Job posting management endpoints",
      "item": [
        {
          "name": "Browse All Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs?search=&location=&skills=&salary_min=&job_type=&experience_level=&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "Search in title/description"
                },
                {
                  "key": "location",
                  "value": "",
                  "description": "Filter by location"
                },
                {
                  "key": "skills",
                  "value": "",
                  "description": "Comma-separated skills"
                },
                {
                  "key": "salary_min",
                  "value": "",
                  "description": "Minimum salary"
                },
                {
                  "key": "job_type",
                  "value": "",
                  "description": "full-time, part-time, contract, internship, remote"
                },
                {
                  "key": "experience_level",
                  "value": "",
                  "description": "entry, mid, senior, lead, executive"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve paginated list of active jobs (public endpoint)"
          }
        },
        {
          "name": "Get Job Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Retrieve detailed information about a specific job"
          }
        },
        {
          "name": "Create Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const responseData = pm.response.json();",
                  "  pm.environment.set('job_id', responseData.job._id);",
                  "  console.log('Job ID saved:', pm.environment.get('job_id'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Backend Developer\",\n  \"description\": \"Build scalable backend systems for our platform using Node.js and MongoDB\",\n  \"requirements\": \"5+ years experience with Node.js and MongoDB. Must have AWS experience.\",\n  \"company\": \"Tech Corp\",\n  \"location\": \"San Francisco, CA\",\n  \"jobType\": \"full-time\",\n  \"experienceLevel\": \"senior\",\n  \"skills\": [\"Node.js\", \"MongoDB\", \"AWS\"],\n  \"salary\": {\n    \"min\": 120000,\n    \"max\": 180000,\n    \"currency\": \"USD\"\n  },\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"]
            },
            "description": "Create a new job posting (recruiters and admins only)"
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paused\",\n  \"salary\": {\n    \"min\": 130000,\n    \"max\": 190000\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Update an existing job posting (owner or admin only)"
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Remove a job posting (owner or admin only)"
          }
        },
        {
          "name": "Get My Job Postings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/my-jobs?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["jobs", "my-jobs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve all jobs posted by authenticated recruiter"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "description": "Job application management endpoints",
      "item": [
        {
          "name": "Apply to Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const responseData = pm.response.json();",
                  "  pm.environment.set('application_id', responseData.application._id);",
                  "  console.log('Application ID saved:', pm.environment.get('application_id'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{job_id}}\",\n  \"coverLetter\": \"I am very interested in this position because I have extensive experience with the required technologies and I'm excited about the opportunity to work with your team.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications",
              "host": ["{{base_url}}"],
              "path": ["applications"]
            },
            "description": "Submit application for a job posting (job seekers only)"
          }
        },
        {
          "name": "Get My Applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/my-applications?status=&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["applications", "my-applications"],
              "query": [
                {
                  "key": "status",
                  "value": "",
                  "description": "pending, reviewed, interview, accepted, rejected"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve all applications submitted by job seeker"
          }
        },
        {
          "name": "Get Application Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}",
              "host": ["{{base_url}}"],
              "path": ["applications", "{{application_id}}"]
            },
            "description": "Get detailed information about a specific application"
          }
        },
        {
          "name": "Get Job Applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/jobs/{{job_id}}/applications?status=&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["applications", "jobs", "{{job_id}}", "applications"],
              "query": [
                {
                  "key": "status",
                  "value": "",
                  "description": "Optional status filter"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve all applications for a job (recruiter or admin only)"
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"interview\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["applications", "{{application_id}}", "status"]
            },
            "description": "Move application through hiring workflow (recruiter or admin only)"
          }
        }
      ]
    },
