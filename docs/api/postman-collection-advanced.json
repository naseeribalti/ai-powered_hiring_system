    {
      "name": "Complete Workflow Scenarios",
      "description": "End-to-end workflow scenarios",
      "item": [
        {
          "name": "📋 Scenario 1: Complete Job Application Flow",
          "description": "1. Login as job seeker → 2. Browse jobs → 3. View job details → 4. Apply to job → 5. View my applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/my-applications",
              "host": ["{{base_url}}"],
              "path": ["applications", "my-applications"]
            }
          }
        },
        {
          "name": "📋 Scenario 2: Recruiter Job Management Flow",
          "description": "1. Login as recruiter → 2. Create job → 3. View my jobs → 4. View applications → 5. Update application status",
          "request": {
            "method": "GET",
            "header": [
