  "item": [
    {
      "name": "Setup & Authentication",
      "description": "Setup workflows and authentication tests",
      "item": [
        {
          "name": "1️⃣ Setup - Check Backend Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verify backend is running"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Backend is healthy', function() {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.equal('ok');",
                  "});",
                  "",
                  "console.log('✅ Backend health check passed');",
                  "console.log('Uptime:', pm.response.json().uptime, 'seconds');"
                ]
              }
            }
          ]
        },
        {
          "name": "2️⃣ Auth - Register Job Seeker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Seeker\",\n  \"email\": \"{{jobseeker_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"jobSeeker\",\n  \"phone\": \"+1-555-0001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Job seeker registered successfully', function() {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().user.role).to.equal('jobSeeker');",
                  "});",
                  "",
                  "if (pm.response.code === 201 || pm.response.code === 409) {",
                  "  console.log('✅ Job seeker account ready');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3️⃣ Auth - Login as Job Seeker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{jobseeker_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response).to.have.property('token');",
                  "  pm.expect(response.user.role).to.equal('jobSeeker');",
                  "});",
                  "",
                  "const responseData = pm.response.json();",
                  "pm.environment.set('token', responseData.token);",
                  "pm.environment.set('user_id', responseData.user._id);",
                  "",
                  "console.log('✅ Logged in as job seeker');",
                  "console.log('Token:', responseData.token.substring(0, 20) + '...');"
                ]
              }
            }
          ]
        },
        {
          "name": "4️⃣ Auth - Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profile retrieved successfully', function() {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user).to.have.property('_id');",
                  "  pm.expect(pm.response.json().user).to.have.property('email');",
                  "});",
                  "",
                  "console.log('✅ Current user profile retrieved');"
                ]
              }
            }
          ]
        }
      ]
