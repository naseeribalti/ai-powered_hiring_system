# Example environment variables for backend
PORT=3001
MONGODB_URI=mongodb://localhost:27017/ai_hiring
JWT_SECRET=change_this_to_a_secure_value
NODE_ENV=development

# Cloudinary Configuration (Required for resume uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ML Service URL
ML_SERVICE_URL=http://localhost:3002

# Optional third-party API keys
# OPENAI_API_KEY=
